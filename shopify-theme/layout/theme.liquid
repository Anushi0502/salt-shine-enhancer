<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- liquid
      assign title_text = page_title | default: shop.name
      assign seo_description_text = page_description | default: 'SALT Online Store offers curated cookware, gifts, apparel, and everyday essentials with secure checkout and fast dispatch.'
      assign search_target_url = shop.secure_url | append: '/shop?q={search_term_string}'
    -%}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#d26633">
    <meta name="application-name" content="SALT Online Store">
    <meta name="description" content="{{ seo_description_text | escape }}">
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
    <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
    <title>{{ title_text | escape }}{% if current_tags %} · {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" href="{{ 'brand-salt-logo.png' | asset_url }}" type="image/png" media="(prefers-color-scheme: light)">
    <link rel="icon" href="{{ 'brand-salt-logo-dark.png' | asset_url }}" type="image/png" media="(prefers-color-scheme: dark)">
    <link rel="apple-touch-icon" href="{{ 'brand-salt-logo.png' | asset_url }}">

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ title_text | escape }}">
    <meta property="og:description" content="{{ seo_description_text | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:image" content="{{ 'brand-salt-logo.png' | asset_url }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title_text | escape }}">
    <meta name="twitter:description" content="{{ seo_description_text | escape }}">
    <meta name="twitter:image" content="{{ 'brand-salt-logo.png' | asset_url }}">

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "SALT Online Store",
        "alternateName": ["Saltonlinestore", "Salt Online Store", "SALT Store", "Saltonline store"],
        "url": {{ shop.secure_url | json }},
        "logo": {{ 'brand-salt-logo.png' | asset_url | json }},
        "sameAs": [
          "https://www.instagram.com/saltonlinestore",
          "https://www.facebook.com/people/SALT-online-store/61573199456052/",
          "https://www.youtube.com/@SALTONLINESTORE"
        ]
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "SALT Online Store",
        "alternateName": ["Saltonlinestore", "Salt Online Store", "SALT Store"],
        "url": {{ shop.secure_url | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": {{ search_target_url | json }},
          "query-input": "required name=search_term_string"
        }
      }
    </script>

    <!-- Meta Pixel Code -->
    <script>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1617705319275041');
      fbq('track', 'PageView');
    </script>
    <!-- End Meta Pixel Code -->
    {{ content_for_header }}
    {{ 'salt-app.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1617705319275041&ev=PageView&noscript=1" alt="" /></noscript>
    {{ content_for_layout }}
  </body>
</html>
