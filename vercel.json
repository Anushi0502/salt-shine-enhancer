{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/__salt_shopify/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, Accept"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/__salt_shopify/(.*)",
      "dest": "https://0309d3-72.myshopify.com/$1"
    },
    {
      "src": "/api/judgeme/(.*)",
      "dest": "/api/judgeme/$1"
    },
    {
      "src": "/api/finance/(.*)",
      "dest": "/api/finance/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
