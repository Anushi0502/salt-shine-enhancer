<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_shell_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/content_header_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="@color/salt_surface"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/salt_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/content_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                android:theme="@style/ThemeOverlay.MaterialComponents.Light"
                app:contentInsetStartWithNavigation="0dp"
                app:navigationIconTint="@color/salt_ink"
                app:titleTextColor="@color/salt_ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="2dp"
                android:text="Open store pages inside the app."
                android:textColor="@color/salt_muted"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/content_loading_bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        app:indicatorColor="@color/salt_teal"
        app:trackColor="@color/salt_surface_alt"
        android:indeterminate="true" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:background="@color/salt_surface">

        <WebView
            android:id="@+id/content_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/salt_surface" />

        <LinearLayout
            android:id="@+id/content_loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/salt_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:indicatorColor="@color/salt_teal"
                app:trackColor="@color/salt_surface_alt" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Opening page"
                android:textColor="@color/salt_ink"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_error_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/salt_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/content_error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Unable to load page."
                android:textColor="@color/salt_ink"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/content_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Try again"
                app:backgroundTint="@color/salt_navy"
                app:cornerRadius="22dp"
                android:textColor="@color/salt_surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/content_open_browser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Open in browser"
                app:backgroundTint="@color/salt_surface_alt"
                app:cornerRadius="22dp"
                android:textColor="@color/salt_ink" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
