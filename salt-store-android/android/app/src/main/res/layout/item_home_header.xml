<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/salt_navy"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="#23425F"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/home_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S.A.L.T."
            android:textColor="@color/salt_surface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_header_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Live Shopify data · endless catalog"
            android:textColor="#D5E1EC"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/home_header_counts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_quantity_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="0 products · 0 collections · 0 in cart"
            android:textColor="@color/salt_ink"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_header_search_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/salt_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#35607B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="@color/salt_muted" />

                <TextView
                    android:id="@+id/home_header_search_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Search products, collections, and blogs"
                    android:textColor="@color/salt_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_header_shop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="8dp"
                android:text="Shop"
                app:backgroundTint="@color/salt_surface"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_menu_search"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/salt_ink"
                android:textColor="@color/salt_ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_header_cart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="8dp"
                android:text="Cart"
                app:backgroundTint="@color/salt_surface"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_menu_view"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/salt_ink"
                android:textColor="@color/salt_ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_header_wishlist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginTop="2dp"
                android:text="Wishlist"
                app:backgroundTint="@color/salt_surface"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/btn_star_big_off"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/salt_gold"
                android:textColor="@color/salt_ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_header_browse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp"
                android:layout_marginTop="2dp"
                android:text="Browse"
                app:backgroundTint="@color/salt_surface"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_menu_more"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/salt_ink"
                android:textColor="@color/salt_ink" />
        </GridLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
