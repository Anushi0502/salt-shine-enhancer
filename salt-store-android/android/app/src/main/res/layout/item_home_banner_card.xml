<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="276dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="10dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/salt_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false"
    app:strokeColor="@color/salt_outline"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/home_banner_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher_foreground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#3F0B1320" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/home_banner_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_amazon_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="Live"
                android:textColor="@color/salt_ink"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_banner_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/salt_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_banner_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="#E9EEF5"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/home_banner_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_amazon_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="Shop"
                android:textColor="@color/salt_ink"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
